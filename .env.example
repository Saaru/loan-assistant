# Language model: set ONE key. The first one found is used (Anthropic, then Groq, then Gemini).
# Groq has a free tier, no credit card needed: https://console.groq.com/keys
GROQ_API_KEY=
# GEMINI_API_KEY=          # Google AI Studio free tier: https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=       # Claude (paid)

# Optional model settings
# LA_LLM_PROVIDER=groq                       # anthropic | groq | gemini | ollama | openai_compatible
# LA_MODEL=openai/gpt-oss-120b               # default per provider
# LA_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b  # tried in order when a model hits its rate limit
# LA_LLM_BASE_URL=                           # for openai_compatible (vLLM, OpenRouter, ...)

# Voice: speech-to-text uses GROQ_API_KEY (Whisper). Speech output engine: auto | piper | groq | none
# (auto = local Piper voice if downloaded with `make voices`, else Groq, else the browser's voice)
# LA_TTS_ENGINE=auto

# Optional app settings
# LA_BRAND_NAME=Northwind Finance
# LA_ASSISTANT_NAME=Aria
# LA_BUSINESS_DATE=2026-10-25   # freeze "today" for repeatable demos
# LA_DEMO_MODE=1                # show OTPs in the UI instead of sending SMS
# LA_APP_PORT=8000
# LA_MOCK_PORT=8100
